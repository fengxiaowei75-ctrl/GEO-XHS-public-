# Web/serverless local development template. Replace every placeholder with your own values.
VITE_GATEWAY_OBSERVABILITY_URL=https://<gateway-admin-domain>/

DATABASE_URL=postgresql://app_user:your_password@localhost:5432/your_database
PGHOST=localhost
PGPORT=5432
PGDATABASE=your_database
PGUSER=app_user
PGPASSWORD=your_password
PGSSLMODE=

# Vercel/serverless deployments must use a public HTTPS gateway URL.
GATEWAY_BASE_URL=https://<gateway-public-domain>
GATEWAY_SERVICE_TOKEN=your_gateway_service_token

# Optional read-only database connection for the query endpoint.
DB_QUERY_DATABASE_URL=postgresql://readonly_user:your_readonly_password@localhost:5432/your_database
DB_QUERY_PGHOST=localhost
DB_QUERY_PGPORT=5432
DB_QUERY_PGDATABASE=your_database
DB_QUERY_PGUSER=readonly_user
DB_QUERY_PGPASSWORD=your_readonly_password
DB_QUERY_PGSSLMODE=

COZE_BOT_ID=your_coze_bot_id
EMBEDDING_MODEL=doubao-embedding-vision-251215

IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_SIZE=1024x1024
IMAGE_GENERATION_OVERSEA=false
IMAGE_GENERATION_REFERENCE_FIELD=image
